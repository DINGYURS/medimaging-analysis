# Cloud insight. Process environment variables take precedence.
LLM_API_BASE_URL=https://token.aigcit.com/v1
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=
LLM_JSON_MODE=true
LLM_TIMEOUT_SECONDS=90
LLM_MAX_TOKENS=4096
LLM_MAX_LESIONS=50
LLM_MAX_INPUT_BYTES=100000
LLM_MAX_ATTEMPTS=2
LLM_POLL_INTERVAL_SECONDS=3
# Enable only after the approved SQL migration has been applied.
LLM_WORKER_ENABLED=false
# Schema changes must be explicit and approved.
INITIALIZE_DATABASE_ON_STARTUP=false

# CT lung nodule reference display
CT_REFERENCE_ENABLED=false
CT_REFERENCE_LOBE_PYTHON=
CT_REFERENCE_LOBE_WEIGHTS=
CT_REFERENCE_LOBE_GPU=3

# Optional research texture model for CT references
CT_REFERENCE_TEXTURE_PYTHON=
CT_REFERENCE_TEXTURE_WEIGHTS=
